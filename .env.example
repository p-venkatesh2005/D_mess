# Dwaraka Mess Management System - Environment Variables
# PostgreSQL Configuration

# FLASK_APP is the entrypoint for your application
FLASK_APP=app.py

# FLASK_ENV can be 'development' or 'production'
FLASK_ENV=development

# SECRET_KEY is used for securely signing the session cookie
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=b4e8d9c8f7c1c2d3e9a4d8f2a3b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3

# DATABASE CONFIGURATION - PostgreSQL
# Option 1: Use individual connection parameters
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dwaraka_mess

# Option 2: Use DATABASE_URL directly (for cloud deployments like Heroku, Railway, Render)
# Uncomment and use this if deploying to a PaaS
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Database Connection Pool Settings
DB_POOL_SIZE=10              # Number of connections to maintain in the pool
DB_POOL_RECYCLE=3600         # Recycle connections after 1 hour
DB_MAX_OVERFLOW=20           # Allow up to 20 additional connections beyond pool_size

# Optional configuration overrides
UPLOAD_FOLDER=static/uploads/payments
MAX_CONTENT_LENGTH=5242880

# CLOUDINARY CONFIGURATION (for file uploads)
# Sign up at https://cloudinary.com (free tier: 25GB storage, 25GB bandwidth/month)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=d_mess  # Folder name in Cloudinary for organizing uploads
